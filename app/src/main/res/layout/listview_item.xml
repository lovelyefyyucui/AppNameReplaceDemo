<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:orientation="vertical"
    android:descendantFocusability="afterDescendants"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp">

        <TextView
            android:id="@+id/biaoti"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/light_blue"
            android:maxEms="13"
            android:ellipsize="end"
            android:textSize="20sp"
            />
        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_gravity="bottom"
            android:src="@drawable/ico_author"
            />
        <TextView
            android:id="@+id/zuozhe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:text="@string/app_name"
            android:layout_gravity="bottom"
            android:textColor="@color/light_blue"
            android:maxEms="10"
            android:ellipsize="end"
            android:textSize="14sp"
            />
    </LinearLayout>

    <TextView
        android:id="@+id/neirong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:maxLines="12"
        android:maxEms="18"
        android:ellipsize="end"
        android:textSize="20sp"
        android:text="开心一笑开心一笑开心一笑开心一笑开心一笑"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/collect_iv"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_gravity="center"
            android:src="@drawable/ico_favourite_gray"
            />

        <ImageView
            android:id="@+id/share_iv"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginLeft="10dp"
            android:layout_gravity="center"
            android:src="@drawable/ico_share"
            />

        <ImageView
            android:id="@+id/copy_iv"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginLeft="10dp"
            android:layout_gravity="center"
            android:src="@drawable/ico_copy"
            />

        <ImageView
            android:id="@+id/like_iv"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="10dp"
            android:layout_gravity="center"
            android:src="@drawable/ico_like_gray"
            />

        <TextView
            android:id="@+id/xihuan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:layout_gravity="center"
            android:text="222"
            android:textColor="@color/light_blue"
            android:maxEms="5"
            android:ellipsize="end"
            android:textSize="20sp"
            />

        <ImageView
            android:id="@+id/comment_iv"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginLeft="10dp"
            android:layout_gravity="center"
            android:src="@drawable/ico_comment_blue"
            />

        <TextView
            android:id="@+id/pinglun"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:layout_gravity="center"
            android:text="2"
            android:textColor="@color/light_blue"
            android:maxEms="4"
            android:ellipsize="end"
            android:textSize="20sp"
            />

    </LinearLayout>
        <TextView
            android:id="@+id/riqi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="2017-6-25"
            android:textColor="@color/text_gray"
            android:maxEms="4"
            android:ellipsize="end"
            android:textSize="18sp"
            />
    </LinearLayout>

</LinearLayout>